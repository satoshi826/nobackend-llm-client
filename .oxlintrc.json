{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "import/no-cycle": "error",
    "react/immutability": "off",
    "react/refs": "off",
    "react/purity": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**"
  ],
  "overrides": [
    {
      "files": [
        "sandbox/*.js"
      ],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
