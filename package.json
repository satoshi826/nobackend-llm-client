{
  "name": "nobackend-llm-client",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run lint && npm run lint:deps && vitest run && vite build",
    "build:vault": "vite build --config vite.vault.config.ts",
    "build:fetch": "vite build --config vite.fetch.config.ts",
    "preview:csp": "node scripts/serve-with-headers.mjs dist 4173",
    "mock": "node scripts/mock-venice.mjs 8787",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:deps": "node scripts/check-deps.mjs",
    "perf": "node --no-warnings=ExperimentalWarning scripts/perf/run.ts",
    "e2e": "node --no-warnings=ExperimentalWarning scripts/e2e/run.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "dexie": "^4.4.7",
    "dompurify": "^3.5.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.3.0",
    "pdfjs-dist": "^6.5.438",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.5",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "oxlint": "^1.95.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
