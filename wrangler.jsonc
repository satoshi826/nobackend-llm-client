// Config for serving on Cloudflare Workers (static assets only). There is no Worker code.
// - build.command: build dist/ before deploying (so it works even if the dashboard build command is empty)
// - security headers come from _headers (dist/_headers, generated from csp.config.ts)
// - conversation URLs are #/c/<id> (hash), so unknown paths stay 404 (no fallback to index.html)
// name must match the Worker name in the dashboard
{
  "name": "nobackend-llm-client",
  "compatibility_date": "2026-11-20",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
